{
  "name": "predictive-project-intel",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @ppi/db run generate && pnpm --filter @ppi/db run build",
    "db:migrate": "pnpm --filter @ppi/db run migrate",
    "db:push": "pnpm --filter @ppi/db run push"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
